# Copy to config/pipeline_paths.env and source it before running.

# Root directory for python ML scripts (expects data/ plus results_cancers/results_subtypes)
export CFMEDIP_MAIN_DIR="/absolute/path/to/your/ml_workspace"

# Optional: restrict python model set for quick checks (comma-separated keys)
# Valid keys: lr,svm,knn,rf,xgb,gbm,lda
# export CFMEDIP_MODELS="lr,rf"

# Cancer-vs-normal script generator overrides
export CFMEDIP_CN_CONFIG="/absolute/path/to/Machine_learning_config_combined_CN_classifier_Jan2025.csv"
export CFMEDIP_CN_OUTPUT_DIR="/absolute/path/to/generated_slurm_scripts"
export CFMEDIP_CN_SLURM_DIR="/absolute/path/to/slurm_logs"
export CFMEDIP_CN_RUNNER_SCRIPT="/absolute/path/to/Runner_fragmentation_Cancer_vs_normal.R"
export CFMEDIP_CN_SCRIPTS_DIR="/absolute/path/to/Scripts_which_runners_call/4_Secondary_runner_scripts_primary_runners_call"

# Optional module override for shell runners
# export CFMEDIP_R_MODULE="R/4.1"
